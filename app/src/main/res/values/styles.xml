<resources>
    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:height">68dp</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="CalcDigit" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/digit_bg</item>
        <item name="backgroundTint">@color/digit_bg</item>
        <item name="android:textColor">@color/digit_text</item>
    </style>

    <style name="CalcOp" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/op_bg</item>
        <item name="backgroundTint">@color/op_bg</item>
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcFunc" parent="CalcBtnBase">
        <item name="android:backgroundTint">@color/func_bg</item>
        <item name="backgroundTint">@color/func_bg</item>
        <item name="android:textColor">@color/func_text</item>
    </style>
</resources>
